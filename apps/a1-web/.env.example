# Supabase — accounts + cloud sync. Leave blank to keep them dormant: a1-web
# works fully on local storage without these (the auth UI just won't appear and
# nothing syncs). Set both to enable sign-in and per-user cloud-synced projects.
# Run apps/a1-web/supabase/schema.sql in your Supabase project's SQL editor first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase access for Administration, visit analytics and Backlog
# local sync (`npm run backlog:pull` / `:push` / `:import`). The service key
# bypasses RLS and must never use a VITE_* name or enter the browser bundle.
# SUPABASE_URL falls back to VITE_SUPABASE_URL for local scripts and functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase backups (server-side only — used by `npm run backup:supabase` and the daily
# `.github/workflows/supabase-backup.yml`). The Postgres **Session pooler** connection
# string (Dashboard → Project Settings → Database → Connection string → "Session pooler",
# port 5432) including the DB password. See backups/README.md. Set as a GitHub repo secret
# for the scheduled backup; put it here only for local runs.
SUPABASE_DB_URL=

# PostHog — product analytics. Leave blank to keep it dormant (no events sent).
# Set VITE_POSTHOG_KEY to your PostHog project API key; host defaults to US cloud.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# AI features — OFF unless set to exactly "true". When off, every AI entry point is
# hidden and no Anthropic calls can fire (saves API credits). Set to "true" to enable.
VITE_AI_ENABLED=
