# A1 Jobs is local-only. By default, SQLite data is stored at:
# apps/a1-jobs/data/a1-jobs.sqlite
# Optional override:
A1_JOBS_DB_PATH=

# Optional local Codex bridge override. Defaults to http://127.0.0.1:4317.
VITE_CODEX_BRIDGE_URL=

# Local API secrets, server-side only.
# These are loaded by the Vite local API shim during npm run dev:a1-jobs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5186/api/google-oauth-callback
GOOGLE_OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
