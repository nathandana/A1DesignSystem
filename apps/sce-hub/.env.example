HOST=127.0.0.1
PORT=5191
SCE_DATA_DIR=./data
# In production, set NODE_ENV=production and an exact HTTPS origin.
SCE_ORIGIN=http://127.0.0.1:5191
# Optional password-free access on this computer only. Rejected in production.
SCE_LOCAL_ACCESS=false
# Optional local Poppler executable. PDFs remain visibly unindexed without it.
SCE_PDFTOTEXT=pdftotext
# AI processing is intentionally unavailable; no provider credentials are needed.

# Optional Supabase backend. Omit to use the local SQLite workspace.
SCE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
