{
  "name": "@gtivr4/a1-design-system-react",
  "version": "0.27.0",
  "description": "React components for the A1 token-driven design system.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.js",
  "keywords": [
    "design-system",
    "react",
    "tokens",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathandana/A1DesignSystem.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/nathandana/A1DesignSystem/issues"
  },
  "homepage": "https://a1design.app",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "README.md",
    "CHANGELOG.md",
    "guidelines/**/*.md",
    "src/**/*.css",
    "src/**/*.d.ts",
    "src/**/*.jsx",
    "src/**/*.js",
    "!src/**/*.stories.jsx",
    "!src/tokens/**",
    "!src/rules/**",
    "!src/storybook/**",
    "!src/components/data-grid/**",
    "!src/Breakpoints.stories.jsx",
    "!src/Colors.stories.jsx"
  ],
  "exports": {
    ".": "./src/index.js",
    "./tokens.css": "./src/tokens.css",
    "./themes.css": "./src/themes.css",
    "./breakpoints.css": "./src/breakpoints.css",
    "./color-scheme.css": "./src/color-scheme.css",
    "./utilities/spacing.css": "./src/utilities/spacing.css",
    "./utilities/width.css": "./src/utilities/width.css",
    "./utilities/sr-only.css": "./src/utilities/sr-only.css",
    "./components/*": "./src/components/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "recharts": "^3.9.2"
  },
  "types": "./src/index.d.ts",
  "devDependencies": {
    "react-data-grid": "7.0.0-beta.59"
  }
}
