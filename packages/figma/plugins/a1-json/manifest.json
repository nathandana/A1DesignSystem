{
  "name": "A1:Figma",
  "id": "a1-design-system-component-json",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "editorType": ["figma"],
  "permissions": ["teamlibrary"],
  "relaunchButtons": [
    {
      "command": "open",
      "name": "Open A1:Figma",
      "multipleSelection": true
    }
  ],
  "networkAccess": {
    "allowedDomains": [
      "*",
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com",
      "https://pszmkbfvyjkifbyututo.supabase.co"
    ],
    "reasoning": "A1 Figures can reference user-provided image URLs, which the plugin loads only when a user explicitly imports or updates that Figure.",
    "devAllowedDomains": ["http://localhost:4318"]
  }
}
