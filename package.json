{
  "name": "a1-design-system",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "AI-first multifunctional design system proof of concept.",
  "scripts": {
    "build": "npm run build:priority-guide && npm run build:cat-stack-cafe && npm run build:careguide && npm run build:storybook",
    "build:priority-guide": "npm run build:tokens && vite build examples/priority-guide -- --outDir dist",
    "build:a1-web": "npm run build:tokens && npm run a11y:reports:check && vite build apps/a1-web",
    "build:a1-jobs": "npm run build:tokens && vite build apps/a1-jobs",
    "build:cat-stack-cafe": "npm run build:tokens && vite build examples/cat-stack-cafe -- --outDir dist",
    "build:todo-list": "npm run build:tokens && vite build examples/todo-list -- --outDir dist",
    "build:careguide": "npm run build:tokens && vite build examples/careguide -- --outDir dist",
    "build:tokens": "style-dictionary build --config sd.config.js && node system/build-themes.mjs && node scripts/build-html-css.mjs && node scripts/color/audit-color-tokens.mjs --check",
    "build:html-css": "npm run build:tokens",
    "build:themes": "node system/build-themes.mjs",
    "tokens:audit": "node scripts/color/audit-color-tokens.mjs",
    "tokens:audit:check": "node scripts/color/audit-color-tokens.mjs --check",
    "tokens:contract:update": "node scripts/color/capture-color-contract.mjs --update",
    "tokens:contract:check": "node scripts/color/capture-color-contract.mjs",
    "pack:check": "node scripts/verify-pack.mjs",
    "build:storybook": "storybook build",
    "check": "npm --version",
    "clean:tokens": "style-dictionary clean",
    "dev": "vite --host 127.0.0.1 --strictPort --port 5176",
    "dev:examples": "vite --host 127.0.0.1 --strictPort --port 5176",
    "dev:button": "vite --host 127.0.0.1 --strictPort --port 5182 --open /examples/react-button/",
    "dev:priority-guide": "vite --host 127.0.0.1 --strictPort --port 5178 --open /examples/priority-guide/",
    "dev:cat-stack-cafe": "vite --host 127.0.0.1 --strictPort --port 5179 --open /examples/cat-stack-cafe/",
    "dev:careguide": "vite --host 127.0.0.1 --strictPort --port 5183 --open /examples/careguide/",
    "dev:dayflow": "vite --host 127.0.0.1 --strictPort --port 5185 --open /examples/dayflow/",
    "dev:catlympics": "vite --host 127.0.0.1 --strictPort --port 5181 --open /examples/cat-lympics/",
    "dev:todo-list": "vite --host 127.0.0.1 --strictPort --port 5183 --open /examples/todo-list/",
    "dev:autodex": "vite --host 127.0.0.1 --strictPort --port 5184 --open /examples/autodex/",
    "build:autodex": "npm run build:tokens && vite build examples/autodex -- --outDir dist",
    "preview:autodex": "vite preview examples/autodex --host 127.0.0.1 --strictPort --port 4185",
    "dev:a1-web": "vite apps/a1-web --host 127.0.0.1 --strictPort --port 5177",
    "codex:bridge:a1-web": "node apps/a1-web/scripts/codex-bridge.mjs",
    "dev:a1-jobs": "vite apps/a1-jobs --host 127.0.0.1 --strictPort --port 5186",
    "codex:bridge:jobs": "node apps/a1-jobs/scripts/codex-bridge.mjs",
    "backlog:pull": "node --env-file-if-exists=apps/a1-web/.env --env-file-if-exists=apps/a1-web/.env.local apps/a1-web/scripts/backlog-sync.mjs pull",
    "backlog:push": "node --env-file-if-exists=apps/a1-web/.env --env-file-if-exists=apps/a1-web/.env.local apps/a1-web/scripts/backlog-sync.mjs push",
    "backlog:import": "node --env-file-if-exists=apps/a1-web/.env --env-file-if-exists=apps/a1-web/.env.local apps/a1-web/scripts/backlog-import-todo.mjs",
    "backup:supabase": "node --env-file-if-exists=apps/a1-web/.env --env-file-if-exists=apps/a1-web/.env.local scripts/backup-supabase.mjs",
    "walkthrough:prompt": "node scripts/walkthrough/prompt-to-spec.mjs",
    "walkthrough:capture": "node scripts/walkthrough/capture.mjs",
    "walkthrough:narration": "node scripts/walkthrough/narration.mjs",
    "walkthrough:render": "node scripts/walkthrough/render.mjs",
    "walkthrough:demo": "node scripts/walkthrough/demo.mjs",
    "dev:theme-editor": "npm run build:tokens && vite --host 127.0.0.1 --strictPort --port 5180 --open /examples/theme-editor/",
    "preview:priority-guide": "vite preview examples/priority-guide --host 127.0.0.1 --strictPort --port 4178",
    "preview:cat-stack-cafe": "vite preview examples/cat-stack-cafe --host 127.0.0.1 --strictPort --port 4179",
    "preview:todo-list": "vite preview examples/todo-list --host 127.0.0.1 --strictPort --port 4183",
    "preview:careguide": "vite preview examples/careguide --host 127.0.0.1 --strictPort --port 4184",
    "build:dayflow": "npm run build:tokens && vite build examples/dayflow -- --outDir dist",
    "preview:dayflow": "vite preview examples/dayflow --host 127.0.0.1 --strictPort --port 4186",
    "preview:a1-jobs": "vite preview apps/a1-jobs --host 127.0.0.1 --strictPort --port 4187",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "test:qa": "sh -c 'node .storybook/qa-setup.mjs && (test-storybook --url http://localhost:6006 --testTimeout=60000; CODE=$?; node .storybook/qa-report.mjs; exit $CODE)'",
    "test:qa:update": "sh -c 'node .storybook/qa-setup.mjs && (UPDATE_SNAPSHOTS=true test-storybook --url http://localhost:6006 --testTimeout=60000; CODE=$?; node .storybook/qa-report.mjs; exit $CODE)'",
    "a11y:component": "node scripts/a11y/run-component.mjs",
    "a11y:changed": "node scripts/a11y/run-changed.mjs",
    "a11y:playwright": "node scripts/a11y/run-playwright.mjs",
    "a11y:report": "node .storybook/qa-report.mjs",
    "a11y:reports": "node scripts/a11y/generate-component-reports.mjs",
    "a11y:reports:check": "node scripts/a11y/generate-component-reports.mjs --check",
    "a11y:full": "npm run test:qa && npm run a11y:playwright",
    "build:eslint-rules": "node scripts/build-eslint-rules.mjs",
    "lint": "node scripts/build-eslint-rules.mjs --check && eslint . && node scripts/lint-a1-css.mjs",
    "lint:fix": "node scripts/build-eslint-rules.mjs && eslint . --fix && node scripts/lint-a1-css.mjs",
    "lint:rules": "npm test --workspace=eslint-plugin-a1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "culori": "^4.0.2",
    "style-dictionary": "^5.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@remotion/cli": "^4.0.484",
    "@remotion/renderer": "^4.0.484",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@storybook/test-runner": "^0.24.4",
    "eslint": "^10.5.0",
    "eslint-plugin-a1": "*",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lit": "^3.3.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss-custom-media": "^12.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.484",
    "storybook": "^10.4.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.13",
    "yaml": "^2.9.0"
  }
}
