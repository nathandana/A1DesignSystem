{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/react/src/**/*.jsx",
    "packages/react/src/**/*.d.ts",
    "examples/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "build"
  ]
}
