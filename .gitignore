.tools/
node_modules/

# Local env files — may hold secrets (Supabase keys, etc.). Never commit.
.env.local
.env*.local

# QA report output — generated per run, not committed.
# Exception: a11y.json is a build-time data dependency of the a1-web
# Accessibility page (statically imported), so it must be tracked.
reports/*
!reports/a11y.json
# Playwright test artifacts — generated per run, not committed
test-results/
# Storybook build output — generated per run, not committed
storybook-static/
# visual-baselines/ is intentionally tracked (via Git LFS)
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.ds-sync/
ds-bundle/
