{
  "base": {
    "icon": {
      "opticalSize": {
        "$type": "number",
        "$value": 24
      }
    },
    "font": {
      "family": {
        "body": {
          "$type": "fontFamily",
          "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        },
        "heading": {
          "$type": "fontFamily",
          "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        },
        "display": {
          "$type": "fontFamily",
          "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace"
        }
      },
      "size": {
        "root": {
          "$type": "dimension",
          "$value": "1rem"
        },
        "user": {
          "small": {
            "$type": "dimension",
            "$value": "0.875rem"
          },
          "medium": {
            "$type": "dimension",
            "$value": "{base.font.size.root}"
          },
          "large": {
            "$type": "dimension",
            "$value": "1.125rem"
          },
          "xl": {
            "$type": "dimension",
            "$value": "1.25rem"
          }
        },
        "scale": {
          "25": {
            "$type": "dimension",
            "$value": "0.5rem"
          },
          "50": {
            "$type": "dimension",
            "$value": "0.625rem"
          },
          "100": {
            "$type": "dimension",
            "$value": "0.75rem"
          },
          "150": {
            "$type": "dimension",
            "$value": "0.875rem"
          },
          "200": {
            "$type": "dimension",
            "$value": "{base.font.size.root}"
          },
          "250": {
            "$type": "dimension",
            "$value": "1.125rem"
          },
          "300": {
            "$type": "dimension",
            "$value": "1.25rem"
          },
          "400": {
            "$type": "dimension",
            "$value": "1.5rem"
          },
          "500": {
            "$type": "dimension",
            "$value": "1.75rem"
          },
          "600": {
            "$type": "dimension",
            "$value": "2rem"
          },
          "700": {
            "$type": "dimension",
            "$value": "2.5rem"
          },
          "800": {
            "$type": "dimension",
            "$value": "3.5rem"
          },
          "900": {
            "$type": "dimension",
            "$value": "4.5rem"
          },
          "1000": {
            "$type": "dimension",
            "$value": "6rem"
          }
        },
        "accessibleScale": {
          "100": {
            "$type": "dimension",
            "$value": "0.84375rem"
          },
          "150": {
            "$type": "dimension",
            "$value": "0.984375rem"
          },
          "200": {
            "$type": "dimension",
            "$value": "1.125rem"
          },
          "250": {
            "$type": "dimension",
            "$value": "1.265625rem"
          },
          "300": {
            "$type": "dimension",
            "$value": "1.40625rem"
          },
          "400": {
            "$type": "dimension",
            "$value": "1.6875rem"
          },
          "500": {
            "$type": "dimension",
            "$value": "1.96875rem"
          },
          "600": {
            "$type": "dimension",
            "$value": "2.25rem"
          },
          "700": {
            "$type": "dimension",
            "$value": "2.8125rem"
          },
          "800": {
            "$type": "dimension",
            "$value": "3.9375rem"
          },
          "900": {
            "$type": "dimension",
            "$value": "5.0625rem"
          },
          "1000": {
            "$type": "dimension",
            "$value": "6.75rem"
          }
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        },
        "extraBold": {
          "$type": "fontWeight",
          "$value": 900
        }
      },
      "lineHeight": {
        "body": {
          "$type": "lineHeight",
          "$value": "1.5em"
        },
        "heading": {
          "$type": "lineHeight",
          "$value": "1.25em"
        },
        "display": {
          "$type": "lineHeight",
          "$value": "1.125em"
        }
      }
    }
  },
  "semantic": {
    "font": {
      "size": {
        "body": {
          "3xs": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.25}"
          },
          "2xs": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.50}"
          },
          "xs": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.100}"
          },
          "sm": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.150}"
          },
          "md": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.200}"
          },
          "lg": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.250}"
          },
          "xl": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.300}"
          }
        },
        "formLabel": {
          "$description": "Single source of truth for form-field label/legend size by density. Used by Field, CheckboxGroup, RadioGroup, and ChoiceGroup so their labels never drift.",
          "compact": {
            "$type": "dimension",
            "$value": "{semantic.font.size.body.xs}"
          },
          "default": {
            "$type": "dimension",
            "$value": "{semantic.font.size.body.sm}"
          },
          "comfortable": {
            "$type": "dimension",
            "$value": "{semantic.font.size.body.md}"
          }
        },
        "heading": {
          "xxl": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.700}"
          },
          "xl": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.600}"
          },
          "lg": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.500}"
          },
          "md": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.400}"
          },
          "sm": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.300}"
          },
          "xs": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.250}"
          }
        },
        "display": {
          "sm": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.400}"
          },
          "md": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.500}"
          },
          "lg": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.600}"
          },
          "xl": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.700}"
          },
          "xxl": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.800}"
          },
          "jumbo": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.900}"
          },
          "xJumbo": {
            "$type": "dimension",
            "$value": "{base.font.size.scale.1000}"
          }
        }
      },
      "weight": {
        "body": {
          "$type": "fontWeight",
          "$value": "{base.font.weight.regular}"
        },
        "heading": {
          "$type": "fontWeight",
          "$value": "{base.font.weight.bold}"
        },
        "display": {
          "$type": "fontWeight",
          "$value": "{base.font.weight.extraBold}"
        }
      },
      "lineHeight": {
        "body": {
          "$type": "lineHeight",
          "$value": "{base.font.lineHeight.body}"
        },
        "heading": {
          "$type": "lineHeight",
          "$value": "{base.font.lineHeight.heading}"
        },
        "display": {
          "$type": "lineHeight",
          "$value": "{base.font.lineHeight.display}"
        }
      }
    }
  },
  "component": {
    "button": {
      "font": {
        "family": {
          "$type": "fontFamily",
          "$value": "{base.font.family.body}"
        },
        "size": {
          "$type": "dimension",
          "$value": "{semantic.font.size.body.md}"
        },
        "weight": {
          "$type": "fontWeight",
          "$value": "{base.font.weight.bold}"
        },
        "lineHeight": {
          "$type": "lineHeight",
          "$value": "normal"
        }
      }
    },
    "card": {
      "title": {
        "font": {
          "size": {
            "$type": "dimension",
            "$value": "{semantic.font.size.heading.sm}"
          },
          "weight": {
            "$type": "fontWeight",
            "$value": "{semantic.font.weight.heading}"
          },
          "lineHeight": {
            "$type": "lineHeight",
            "$value": "{semantic.font.lineHeight.heading}"
          }
        }
      },
      "body": {
        "font": {
          "size": {
            "$type": "dimension",
            "$value": "{semantic.font.size.body.md}"
          },
          "weight": {
            "$type": "fontWeight",
            "$value": "{semantic.font.weight.body}"
          },
          "lineHeight": {
            "$type": "lineHeight",
            "$value": "{semantic.font.lineHeight.body}"
          }
        }
      }
    },
    "inline": {
      "font": {
        "family": {
          "mono": {
            "$type": "fontFamily",
            "$value": "{base.font.family.mono}"
          }
        }
      }
    },
    "paragraph": {
      "font": {
        "family": {
          "$type": "fontFamily",
          "$value": "{base.font.family.body}"
        },
        "weight": {
          "$type": "fontWeight",
          "$value": "{semantic.font.weight.body}"
        },
        "lineHeight": {
          "$type": "lineHeight",
          "$value": "1.75em"
        }
      }
    },
    "heading": {
      "font": {
        "family": {
          "heading": {
            "$type": "fontFamily",
            "$value": "{base.font.family.heading}"
          },
          "display": {
            "$type": "fontFamily",
            "$value": "{base.font.family.display}"
          }
        },
        "weight": {
          "heading": {
            "$type": "fontWeight",
            "$value": "{semantic.font.weight.heading}"
          },
          "display": {
            "$type": "fontWeight",
            "$value": "{semantic.font.weight.display}"
          }
        },
        "lineHeight": {
          "heading": {
            "$type": "lineHeight",
            "$value": "{semantic.font.lineHeight.heading}"
          },
          "display": {
            "$type": "lineHeight",
            "$value": "{semantic.font.lineHeight.display}"
          }
        }
      }
    }
  }
}
