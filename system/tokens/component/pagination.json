{
  "component": {
    "pagination": {
      "itemSize":             { "$type": "dimension",  "$value": "36px" },
      "itemSizeSm":           { "$type": "dimension",  "$value": "28px" },
      "gap":                  { "$type": "dimension",  "$value": "{base.spacing.4}" },
      "borderWidth":          { "$type": "dimension",  "$value": "{base.spacing.1}" },
      "selectedBackground":   { "$type": "color",      "$value": "{semantic.color.action.background}" },
      "selectedBackgroundHover": { "$type": "color",   "$value": "{semantic.color.action.backgroundHover}" },
      "selectedBackgroundPressed": { "$type": "color", "$value": "{semantic.color.action.backgroundPressed}" },
      "selectedBorder":       { "$type": "color",      "$value": "{semantic.color.action.background}" },
      "selectedBorderHover":  { "$type": "color",      "$value": "{semantic.color.action.backgroundHover}" },
      "selectedBorderPressed":{ "$type": "color",      "$value": "{semantic.color.action.backgroundPressed}" },
      "selectedForeground":   { "$type": "color",      "$value": "{semantic.color.action.foreground}" },
      "selectedForegroundHover": { "$type": "color",   "$value": "{semantic.color.action.foreground}" },
      "selectedForegroundPressed": { "$type": "color", "$value": "{semantic.color.action.foreground}" },
      "fontWeightDefault":    { "$type": "fontWeight", "$value": "{base.font.weight.regular}" },
      "fontWeightActive":     { "$type": "fontWeight", "$value": "{base.font.weight.medium}" },
      "focusRingWidth":       { "$type": "dimension",  "$value": "2px" },
      "focusRingOffset":      { "$type": "dimension",  "$value": "2px" },
      "disabledOpacity":      { "$type": "opacity",    "$value": 0.35 },
      "ellipsisPaddingBottom":{ "$type": "dimension",  "$value": "{base.spacing.4}" }
    }
  }
}
