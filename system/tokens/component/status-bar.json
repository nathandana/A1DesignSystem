{
  "component": {
    "statusBar": {
      "sm":           { "height": { "$type": "dimension", "$value": "{base.spacing.4}" } },
      "md":           { "height": { "$type": "dimension", "$value": "{base.spacing.8}" } },
      "lg":           { "height": { "$type": "dimension", "$value": "{base.spacing.12}" } },
      "borderRadius": { "$type": "dimension", "$value": "9999px" },
      "borderWidth":  { "$type": "dimension", "$value": "0px" },
      "borderColor":  { "$type": "color",     "$value": "{semantic.color.border.default}" },
      "trackBackground": { "$type": "color",  "$value": "{semantic.color.surface.raised}" },
      "fillBackground":  { "$type": "color",  "$value": "{semantic.color.action.background}" },
      "labelGap":     { "$type": "dimension", "$value": "{base.spacing.8}" },
      "indeterminate": {
        "duration": { "$value": "1400ms" }
      }
    }
  }
}
