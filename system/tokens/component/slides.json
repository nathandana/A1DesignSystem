        },
        "5": {
          "$type": "color",
          "$value": "{base.color.info.500}",
          "$description": "Cool ramp swatch 6 (Components slide)."
        },
        "6": {
          "$type": "color",
          "$value": "{base.color.info.600}",
          "$description": "Cool ramp swatch 7 (Components slide)."
        },
        "7": {
          "$type": "color",
          "$value": "{base.color.info.700}",
          "$description": "Cool ramp swatch 8 (Components slide)."
        },
        "8": {
          "$type": "color",
          "$value": "{base.color.info.800}",
          "$description": "Cool ramp swatch 9 (Components slide)."
        },
        "9": {
          "$type": "color",
          "$value": "{base.color.info.900}",
          "$description": "Cool ramp swatch 10 (Components slide)."
        }
      },
      "handoff": {
        "$type": "number",
        "$value": 0.5,
        "$description": "Point in a transition (fraction of its duration) where the next slide takes over: the wipe swap and the start of cascade arrivals."
      },
      "fadeOutBy": {
        "$type": "number",
        "$value": 0.4,
        "$description": "Fraction of a transition by which outgoing content has faded or started to leave."
      },
      "fadeInFrom": {
        "$type": "number",
        "$value": 0.45,
        "$description": "Fraction of a transition after which incoming content fades in."
      },
      "pieceShare": {
        "$type": "number",
        "$value": 0.4,
        "$description": "Cascade: each piece's movement as a fraction of the transition."
      }
    }
  }
}
