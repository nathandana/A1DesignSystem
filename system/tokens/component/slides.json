          "$value": "{base.color.warn.700}",
          "$description": "Warm ramp swatch 8 (Foundations slide)."
        },
        "8": {
          "$type": "color",
          "$value": "{base.color.warn.800}",
          "$description": "Warm ramp swatch 9 (Foundations slide)."
        },
        "9": {
          "$type": "color",
          "$value": "{base.color.warn.900}",
          "$description": "Warm ramp swatch 10 (Foundations slide)."
        }
      },
      "rampCool": {
        "0": {
          "$type": "color",
          "$value": "{base.color.info.50}",
          "$description": "Cool ramp swatch 1 (Components slide)."
        },
        "1": {
          "$type": "color",
          "$value": "{base.color.info.100}",
          "$description": "Cool ramp swatch 2 (Components slide)."
        },
        "2": {
          "$type": "color",
          "$value": "{base.color.info.200}",
