{
  "component": {
    "slides": {
      "canvasWidth": {
        "$type": "dimension",
        "$value": "{base.width.2xl}",
        "$description": "Design width of a slide; the 16:9 canvas is scaled to fit the stage."
      },
      "padding": {
        "$type": "dimension",
        "$value": "{base.spacing.48}",
        "$description": "Inner margin of a slide."
      },
      "stripe": {
        "$type": "dimension",
        "$value": "{base.spacing.6}",
        "$description": "Height of the multicolour footer stripe."
      },
      "bigIcon": {
        "$type": "dimension",
        "$value": "{base.spacing.192}",
        "$description": "Glyph size of a statement slide's large icon."
      },
      "logo": {
        "$type": "dimension",
        "$value": "{base.spacing.96}",
        "$description": "Size of the logo tile on the title slide."
      },
      "shift": {
        "$type": "dimension",
        "$value": "{base.spacing.24}",
        "$description": "Distance pieces travel when they cascade or rise into place."
      },
      "zoomOut": {
        "$type": "number",
        "$value": 1.12,
        "$description": "Zoom: scale the outgoing slide grows to as it fades."
      },
      "zoomIn": {
        "$type": "number",
        "$value": 0.92,
        "$description": "Zoom: scale the incoming slide grows from."
      },
      "speedQuick": {
        "$type": "duration",
        "$value": "{semantic.motion.duration.slow}",
        "$description": "Quick slide transition."
      },
      "speedStandard": {
        "$type": "duration",
        "$value": "{semantic.motion.duration.slower}",
        "$description": "Standard slide transition."
      },
      "speedRelaxed": {
        "$type": "duration",
        "$value": "{semantic.motion.duration.slowest}",
        "$description": "Relaxed slide transition."
      },
      "staggerStep": {
        "$type": "duration",
        "$value": "{semantic.motion.duration.quick}",
        "$description": "Delay between pieces in a cascade or a rising build."
      },
      "buildDuration": {
        "$type": "duration",
        "$value": "{semantic.motion.duration.slow}",
        "$description": "Duration of each piece's build animation."
      },
      "aspectRatio": {
        "$value": "16 / 9",
        "$description": "Proportion of the stage and the slide canvas."
      },
      "rampWarm": {
        "0": {
          "$type": "color",
          "$value": "{base.color.warn.50}",
          "$description": "Warm ramp swatch 1 (Foundations slide)."
        },
        "1": {
