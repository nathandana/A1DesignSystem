          "$value": "{base.color.warn.500}",
          "$description": "Warm ramp swatch 6 (Foundations slide)."
        },
        "6": {
          "$type": "color",
          "$value": "{base.color.warn.600}",
          "$description": "Warm ramp swatch 7 (Foundations slide)."
        },
        "7": {
