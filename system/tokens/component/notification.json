{
  "component": {
    "notification": {
      "height":        { "$type": "dimension", "$value": "18px" },
      "dotSize":       { "$type": "dimension", "$value": "8px" },
      "paddingInline": { "$type": "dimension", "$value": "5px" },
      "fontSize":      { "$type": "dimension", "$value": "11px" },
      "fontWeight":    { "$type": "number",    "$value": 600 },
      "ringWidth":     { "$type": "dimension", "$value": "2px" },
      "neutral": {
        "background": { "$type": "color", "$value": "{base.color.neutral.600}" },
        "foreground": { "$type": "color", "$value": "{base.color.neutral.0}" }
      }
    }
  }
}
