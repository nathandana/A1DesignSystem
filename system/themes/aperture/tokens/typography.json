{
  "theme": {
    "a1Aperture": {
      "font": {
        "family": {
          "body": {
            "$type": "fontFamily",
            "$value": "'Manrope', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
          },
          "heading": {
            "$type": "fontFamily",
            "$value": "'Playfair Display', Georgia, Cambria, 'Times New Roman', serif"
          },
          "display": {
            "$type": "fontFamily",
            "$value": "'Pinyon Script', 'Tangerine', 'Snell Roundhand', cursive"
          }
        },
        "weight": {
          "body": { "$type": "fontWeight", "$value": 400 },
          "heading": { "$type": "fontWeight", "$value": 600 },
          "display": { "$type": "fontWeight", "$value": 400 }
        }
      }
    }
  }
}
