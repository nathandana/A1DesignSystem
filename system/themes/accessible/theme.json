{
  "$schema": "../theme.schema.json",
  "name": "Accessible",
  "description": "Larger font sizes and filled icons for improved legibility. Apply .a1-theme-accessible to <html>.",
  "selectors": [
    {
      "selector": ".a1-theme-accessible",
      "overrides": "overrides/default.json"
    },
    {
      "selector": ".a1-theme-accessible.a1-theme-light, .a1-theme-light.a1-theme-accessible",
      "overrides": "overrides/light.json"
    }
  ],
  "labels": {
    "action.getStarted": "Begin now",
    "action.viewDocumentation": "Read the docs"
  }
}
