{
  "$schema": "../theme.schema.json",
  "name": "CatLympics",
  "description": "Playful, pastel, bouncy theme for CatLympics Game. Apply .a1-theme-catlympics to <html>.",
  "selectors": [
    {
      "selector": ".a1-theme-catlympics",
      "overrides": "overrides/default.json",
      "styles": "styles/default.json"
    },
    {
      "selector": ".a1-theme-catlympics.a1-theme-dark, .a1-theme-dark.a1-theme-catlympics",
      "styles": "styles/dark.json"
    }
  ],
  "labels": {
    "action.play": "Play",
    "action.getStarted": "Begin"
  }
}
