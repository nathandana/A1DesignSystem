            "$type": "fontFamily",
            "$value": "'Nunito Sans', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
          },
          "heading": {
            "$type": "fontFamily",
            "$value": "'Patrick Hand SC', system-ui, -apple-system, sans-serif"
          },
          "display": {
            "$type": "fontFamily",
            "$value": "'Baloo 2', system-ui, -apple-system, sans-serif"
          },
          "mono": {
