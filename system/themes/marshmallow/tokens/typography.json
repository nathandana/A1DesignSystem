{
  "theme": {
    "a1Marshmallow": {
      "font": {
        "family": {
          "body": {
            "$type": "fontFamily",
            "$value": "'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
          },
          "heading": {
            "$type": "fontFamily",
            "$value": "'Space Grotesk', 'Varela Round', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
          },
          "display": {
            "$type": "fontFamily",
            "$value": "'Space Grotesk', 'Varela Round', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
          }
        },
        "weight": {
          "body": { "$type": "fontWeight", "$value": 400 },
          "heading": { "$type": "fontWeight", "$value": 500 },
          "display": { "$type": "fontWeight", "$value": 600 }
        }
      }
    }
  }
}
