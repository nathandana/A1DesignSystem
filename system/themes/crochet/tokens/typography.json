{
  "theme": {
    "a1Crochet": {
      "font": {
        "family": {
          "body": {
            "$type": "fontFamily",
            "$value": "'Roboto Slab', 'Bitter', Rockwell, 'Roboto Slab', Georgia, serif"
          },
          "heading": {
            "$type": "fontFamily",
            "$value": "'Libre Baskerville', Georgia, Cambria, 'Times New Roman', serif"
          },
          "display": {
            "$type": "fontFamily",
            "$value": "'Fraunces', 'Playfair Display', Georgia, Cambria, 'Times New Roman', serif"
          }
        },
        "weight": {
          "body": { "$type": "fontWeight", "$value": 400 },
          "heading": { "$type": "fontWeight", "$value": 700 },
          "display": { "$type": "fontWeight", "$value": 600 }
        }
      }
    }
  }
}
